node {
    checkout scm
    dir('dotnet-demo-app-main') {
        
        stage('Start Environment') {
            // 1. Download de docker-compose tool tijdelijk in de werkmap van Jenkins
            sh 'curl -sSL https://github.com/docker/compose/releases/download/v2.25.0/docker-compose-linux-x86_64 -o docker-compose'
            sh 'chmod +x docker-compose'

            // 2. Gebruik onze gedownloade tool om oude containers af te sluiten
            catchError(buildResult: 'SUCCESS') {
                sh './docker-compose down'
            }
            
            // 3. Bouw en start de MariaDB database en webapp
            sh './docker-compose up -d --build'
            
            // 4. Wacht 10 seconden zodat MariaDB volledig kan opstarten
            sleep 10
            
            // 5. Maak de test-database aan via een tijdelijke MariaDB client
            sh '''
            docker run --rm --network host mariadb:11 mariadb -h 127.0.0.1 -P 3306 -uroot -psekrit -e "CREATE DATABASE IF NOT EXISTS todo_test_db; GRANT ALL PRIVILEGES ON todo_test_db.* TO 'todo_usr'@'%'; FLUSH PRIVILEGES;"
            '''
        }
        
        stage('Integration Tests') {
            // Bouw de containeromgeving
            sh '''
            echo "FROM mcr.microsoft.com/dotnet/sdk:10.0" > Dockerfile.test
            echo "WORKDIR /app" >> Dockerfile.test
            echo "COPY . ." >> Dockerfile.test
            docker build -t dotnet-test-runner -f Dockerfile.test .
            '''
            
            // Voer de tests uit gekoppeld aan de database!
            sh 'docker run --rm --network host dotnet-test-runner dotnet test'
        }
    }
}